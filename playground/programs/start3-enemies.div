PROGRAM start_3_enemies;

// START HERE - STEP 3: ENEMIES
//
// Step 2 plus enemies that fall from the top. collision(TYPE shot) tells
// an enemy whether it touches any shot, and gives back that shot's id so
// the enemy can remove it with signal(). Hitting an enemy scores a point;
// an enemy reaching the ship ends the game - Enter starts again.

GLOBAL
  g_ship;
  g_shot;
  g_enemy;
  g_boom;
  snd_shot;
  snd_boom;
  snd_over;
  score = 0;
  game_over = 0;

PROCESS player();
BEGIN
  graph = g_ship;
  x = 160;
  y = 200;

  LOOP
    IF (key(_left))  x = x - 3; END
    IF (key(_right)) x = x + 3; END
    IF (key(_up))    y = y - 3; END
    IF (key(_down))  y = y + 3; END
    IF (x < 12)  x = 12;  END
    IF (x > 308) x = 308; END
    IF (y < 12)  y = 12;  END
    IF (y > 228) y = 228; END

    IF (key_pressed(_space))
      shot(x, y - 14);
      play_sound(snd_shot, 60);
    END

    // Touching an enemy ends the game
    IF (collision(TYPE enemy))
      boom(x, y);
      play_sound(snd_over, 90);
      game_over = 1;
      RETURN;           // the player process ends here
    END

    FRAME;
  END
END

PROCESS shot(x, y);
BEGIN
  graph = g_shot;
  REPEAT
    y = y - 6;
    FRAME;
  UNTIL (y < -10)
END

// An enemy falls from x at a given speed, drifting a little sideways.
PROCESS enemy(x, speed);
PRIVATE
  drift;
  hit;
BEGIN
  graph = g_enemy;
  y = -12;
  drift = rand(-1, 1);
  REPEAT
    y = y + speed;
    x = x + drift;
    hit = collision(TYPE shot);     // the id of a shot touching us, or 0
    IF (hit)
      signal(hit, s_kill);          // remove that shot
      score = score + 1;
      boom(x, y);
      play_sound(snd_boom, 70);
      RETURN;                       // and this enemy
    END
    FRAME;
  UNTIL (y > 252)                   // fell off the bottom
END

// An explosion: grows for a few frames and disappears.
PROCESS boom(x, y);
BEGIN
  graph = g_boom;
  size = 60;
  REPEAT
    size = size + 15;
    FRAME;
  UNTIL (size > 180)
END

BEGIN
  set_mode(320, 240);
  set_fps(60, 0);

  g_ship = new_graphic(24, 24);
  gfx_rect(g_ship, 10, 0, 4, 10, 140, 210, 255);
  gfx_rect(g_ship, 5, 8, 14, 12, 70, 140, 255);
  gfx_rect(g_ship, 0, 13, 5, 10, 230, 90, 90);
  gfx_rect(g_ship, 19, 13, 5, 10, 230, 90, 90);

  g_shot = new_graphic(4, 10);
  gfx_rect(g_shot, 0, 0, 4, 10, 255, 240, 120);

  g_enemy = new_graphic(20, 20);
  gfx_circle(g_enemy, 10, 10, 9, 120, 220, 90);
  gfx_rect(g_enemy, 5, 7, 3, 3, 20, 40, 20);        // eyes
  gfx_rect(g_enemy, 12, 7, 3, 3, 20, 40, 20);

  g_boom = new_graphic(20, 20);
  gfx_circle(g_boom, 10, 10, 9, 255, 170, 60);
  gfx_circle(g_boom, 10, 10, 5, 255, 240, 170);

  snd_shot = sfx(sfx_laser);
  snd_boom = sfx(sfx_explosion);
  snd_over = sfx(sfx_hit);

  write(0, 8, 8, 0, "Score:");
  write_int(0, 50, 8, 0, OFFSET score);     // always shows the current score

  player();

  LOOP
    // Now and then (about 2 times in 100 frames) a new enemy
    IF (game_over == 0 AND rand(0, 100) < 2)
      enemy(rand(10, 310), rand(1, 3));
    END

    IF (game_over == 1)
      // text() starts at x: 23 letters of 6 pixels, so 160 - 69 centres it
      text(91, 116, "GAME OVER - press Enter");
      IF (key_pressed(_enter))
        signal(TYPE enemy, s_kill);   // clear the enemies
        score = 0;
        game_over = 0;
        player();
      END
    END

    FRAME;
  END
END
