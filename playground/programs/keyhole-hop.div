  lstars[14]; lbest[14];

  // ---- sounds and music
  s_jump = 0; s_land = 0; s_gem = 0; s_key = 0; s_unlock = 0; s_lever = 0;
  s_deny = 0; s_spring = 0; s_push = 0; s_thud = 0; s_plate = 0; s_stomp = 0;
  s_die = 0; s_door = 0; s_star = 0; s_select = 0; s_move = 0; s_step = 0;
  s_climb = 0; s_slam = 0; s_gate = 0; s_nostar = 0;
  m_title = 0; m_map = 0; m_world[2]; m_clear = 0;

