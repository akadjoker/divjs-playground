PROGRAM keyhole_hop;

// ---------------------------------------------------------------------
// KEYHOLE HOP - a puzzle platformer in fifteen small rooms.
//
// Pip the space scout has landed on the Keyhole Isles, where every path
// home is shut behind a door. Each room fits on one screen: find a way
// to its exit door. Keys open lock blocks, levers swap the yellow and
// brown blocks, crates can be pushed (and slide on ice), blue buttons
// hold the blue gates open while something stands on them, springs
// throw you (and crates) up high, platforms ride along, and ladders
// climb. Every room teaches one new idea.
//
// * Three worlds: CLOVER ISLE (grass), FROSTBITE PEAKS (ice: you and
//   the crates slide) and SUNBAKED DUNES (enemies and angry blocks).
// * Up to three stars a room: reach the door, pick up every gem, beat
//   the par time. Progress and best times are saved (save_data).
// * Controls with some weight: speed builds up and runs down, the jump
//   is higher the longer it is held, it still works a few frames after
//   running off a ledge (coyote time) and a press just before landing
//   is kept (jump buffer).
//
// How it is made
// * Every sprite and tile is cut out of Kenney's Pixel Platformer
//   sheets (CC0) with load_tile: tiles are 18x18, characters 24x24,
//   backgrounds 24x24. The screen is 432x252: a HUD bar of 18 pixels
//   and a room of 24x13 tiles.
// * Rooms are written as 13 strings of 24 characters (see lrow below).
//   The still parts (ground, bridges, ladders, spikes, the door) are
//   drawn once into the background with xput; the ground picks its
//   edge tiles from its neighbours. Things that change (locks, yellow
//   and brown blocks, gates, crates...) are processes.
// * Collisions are tested against the room's cell array lv[] and a list
//   of boxes (crates and angry blocks) and platforms, never against
//   graphics; one controller process moves them all in a fixed order.
// * Texts use a 5x7 pixel font built as a BDF font at start-up; sound
//   effects are sfx_tone recipes and every world has its own tune.
// Art: Kenney (kenney.nl), CC0.
// ---------------------------------------------------------------------

GLOBAL
  // ---- screen and room geometry
  SW = 432; SH = 252; TS = 18; GW = 24; GH = 13; OY = 18;
  SHEET = '../assets/kenney/pixel-platformer/tilemap_packed.png';
  CHARS = '../assets/kenney/pixel-platformer/tilemap-characters_packed.png';
  BACKS = '../assets/kenney/pixel-platformer/tilemap-backgrounds_packed.png';

  // ---- cell kinds of lv[]
  C_AIR = 0; C_GROUND = 1; C_BRIDGE = 2; C_YEL = 3; C_BRN = 4; C_LOCK = 5;
  C_SPIKE = 6; C_LADDER = 7; C_GATE = 8; C_STOP = 9; C_SPRING = 10;
  lv[311];                   // the room: cell (tx, ty) is lv[ty * GW + tx]

  // ---- graphics
  tg[179];                   // the 180 tiles of the tile sheet
  cg[26];                    // the 27 characters
  bgt[23];                   // the 24 background tiles
  g_hud = 0; g_star = 0; g_star_off = 0; g_sstar = 0; g_sstar_off = 0;
  g_px[9];                   // particles: small squares of the palette
  g_dot = 0; g_dot_off = 0; g_panel = 0; g_screen = 0; g_bar = 0; g_cold = 0; g_cold_s = 0;
  f_small = 0; f_big = 0; f_huge = 0;

  // ---- the current room
  cur = 0;                   // room 0..14
  world = 0;                 // 0 grass, 1 ice, 2 desert
  NLEV = 15;
  sw_state = 0;              // lever state: 0 yellow solid, 1 brown solid
  plate_on = 0; gate_open = 0;
  nkeys = 0; has_keys = 0;
  gems_got = 0; gems_total = 0;
  lt = 0; tsec = 0;          // frames and seconds spent in the room
  frz = 0;                   // 1 while the room is frozen (door, death)
  won = 0; dead_t = 0; exit_t = 0;
  door_x = 0; door_y = 0;    // door cell
  hint_t = 0; hint_id = 0; hint_sh = 0; up_id = 0; up_sh = 0;

  // ---- player: feet at (pfx, pfy), box PHW each side, PH tall
  pfx = 0.0; pfy = 0.0; pvx = 0.0; pvy = 0.0;
  PHW = 6; PH = 19;
  pground = 0; pcoy = 0; pbuf = 0; pjump = 0; pface = 1; pdead = 0;
  pclimb = 0; pspring = 0; ppush = 0; pice = 0; pwalk = 0.0; pland = 0;
  pon_k = 0; pon_i = 0;      // standing on: 0 floor, 1 platform, 2 box
  stomp_fc = -1; fc = 0;

  // ---- boxes: crates (1) and angry blocks (2); x, y is the top-left
  NB = 0; BK_CRATE = 1; BK_THWOMP = 2;
  bx_k[9]; bx_x[9]; bx_y[9]; bx_vx[9]; bx_vy[9]; bx_on[9]; bx_dx[9]; bx_dy[9];
  bx_st[9]; bx_t[9]; bx_oy[9]; bx_live[9];

  // ---- moving platforms (3 tiles wide), x, y top-left
  NMP = 0;
  mp_x[5]; mp_y[5]; mp_vx[5]; mp_vy[5]; mp_dx[5]; mp_dy[5]; mp_wait[5];

  // ---- plates (buttons) and springs
  NPL = 0; pl_x[7]; pl_y[7]; pl_down[7];
