LOCAL
  fx = 0.0; fy = 0.0;       // exact position of a moving thing

// =====================================================================
// Small helpers
// =====================================================================

FUNCTION iabs(v);
BEGIN
  IF (v < 0) RETURN -v; END
  RETURN v;
END

FUNCTION sgn(v);
BEGIN
  IF (v > 0) RETURN 1; END
  IF (v < 0) RETURN -1; END
  RETURN 0;
END

// Cell coordinate of a pixel coordinate (floor, also for negatives)
FUNCTION tcell(p);
BEGIN
  RETURN floor(p / 18.0);
END

// Cell kind at (tx, ty); the sides are walls, above the room is a
// ceiling (the HUD), below it is open
FUNCTION cell(tx, ty);
BEGIN
  IF (tx < 0 OR tx >= GW) RETURN C_GROUND; END
  IF (ty < 0) RETURN C_GROUND; END
  IF (ty >= GH) RETURN C_AIR; END
  RETURN lv[ty * GW + tx];
END

// 1 when cell kind t blocks movement right now
FUNCTION kind_solid(t);
BEGIN
  IF (t == C_GROUND OR t == C_LOCK) RETURN 1; END
  IF (t == C_YEL) RETURN sw_state == 0; END
  IF (t == C_BRN) RETURN sw_state == 1; END
  IF (t == C_GATE) RETURN NOT gate_open; END
  RETURN 0;
END

FUNCTION solid_c(tx, ty);
BEGIN
  RETURN kind_solid(cell(tx, ty));
END

FUNCTION solid_px(px, py);
BEGIN
  RETURN kind_solid(cell(tcell(px), tcell(py)));
END

// 1 when cell (tx, ty) is the top of a ladder
FUNCTION ladder_top(tx, ty);
BEGIN
  RETURN cell(tx, ty) == C_LADDER AND cell(tx, ty - 1) != C_LADDER;
END

// 1 when the ground under a moving thing is solid from above: solid
// cells, bridges and ladder tops (only from above)
FUNCTION floor_c(tx, ty);
PRIVATE t;
BEGIN
  t = cell(tx, ty);
  IF (kind_solid(t)) RETURN 1; END
  IF (t == C_BRIDGE) RETURN 1; END
  IF (t == C_LADDER AND cell(tx, ty - 1) != C_LADDER) RETURN 1; END
  RETURN 0;
END

FUNCTION k_left();  BEGIN RETURN key(_left) OR key(_a); END
FUNCTION k_right(); BEGIN RETURN key(_right) OR key(_d); END
FUNCTION k_up();    BEGIN RETURN key(_up) OR key(_w); END
FUNCTION k_down();  BEGIN RETURN key(_down) OR key(_s); END
FUNCTION k_jump();  BEGIN RETURN key(_z) OR key(_space) OR key(_k); END
FUNCTION k_jump_p();
BEGIN
  RETURN key_pressed(_z) OR key_pressed(_space) OR key_pressed(_k);
END
FUNCTION k_act_p();
BEGIN
  RETURN key_pressed(_x) OR key_pressed(_down) OR key_pressed(_s) OR key_pressed(_j);
END
FUNCTION k_up_p();
BEGIN
  RETURN key_pressed(_up) OR key_pressed(_w);
END
FUNCTION k_ok_p();
BEGIN
  RETURN key_pressed(_enter) OR key_pressed(_z) OR key_pressed(_space) OR key_pressed(_k);
END

// A tile of the tile sheet as a graphic, cut out of the packed sheet
FUNCTION cut_tile(n);
BEGIN
  RETURN load_tile(SHEET, (n % 20) * 18, (n / 20) * 18, 18, 18);
END

// =====================================================================
// Pixel font: builds a BDF font text from the 5x7 glyphs, every pixel
// drawn as sc x sc, and loads it
// =====================================================================

FUNCTION hex4(v);
BEGIN
  RETURN hexd[(v / 4096) % 16] + hexd[(v / 256) % 16] + hexd[(v / 16) % 16] + hexd[v % 16];
END

FUNCTION font_start(sc);
BEGIN
  fbuf = "STARTFONT 2.1\nFONT keyhole" + sc + "\nSIZE " + (7 * sc) + " 75 75\nFONTBOUNDINGBOX " + (5 * sc) + " " + (7 * sc) + " 0 0\n";
  fbuf = fbuf + "CHARS " + (NGLYPH + 26) + "\n";
  RETURN 0;
END

// Adds glyphs i0..i1 to the font text being built (spread over frames:
// the whole font in one go is too much work for one frame)
FUNCTION font_part(sc, i0, i1);
PRIVATE s, i, r, k, c, n, bits, v, w, code, pass, row_s;
BEGIN
  w = 5 * sc;
  s = "";
  FOR i = i0 TO min(i1, NGLYPH - 1)
    FOR pass = 0 TO 1
      code = fcode[i];
      IF (pass == 1)
        // small letters are the capitals
        IF (code < 65 OR code > 90) CONTINUE; END
        code = code + 32;
      END
      s = s + "STARTCHAR g" + code + "\nENCODING " + code + "\nSWIDTH 500 0\nDWIDTH " + (6 * sc) + " 0\nBBX " + w + " " + (7 * sc) + " 0 0\nBITMAP\n";
      FOR r = 0 TO 6
        n = fglyph[i * 7 + r];
        bits = 0;
        FOR c = 0 TO 4
          v = (n / pow(10, 4 - c)) % 10;
          FOR k = 0 TO sc - 1
            bits = bits * 2 + v;
          END
        END
        bits = bits * pow(2, 16 - w);
        row_s = hex4(bits) + "\n";
        FOR k = 1 TO sc
          s = s + row_s;
        END
      END
      s = s + "ENDCHAR\n";
    END
  END
  fbuf = fbuf + s;
  RETURN 0;
END

FUNCTION font_finish();
BEGIN
  fbuf = fbuf + "ENDFONT\n";
  RETURN load_bdf_font_text(fbuf);
END

// Text with a drop shadow (write texts stay until delete_text); the
// shadow's id is left in txt_sh
FUNCTION shadow_text(f, x, y, al, s, col);
BEGIN
  set_color('#2a2e3e');
  txt_sh = write(f, x + 1, y + 1, al, s);
  set_color(col);
  RETURN write(f, x, y, al, s);
END

// =====================================================================
// Graphics made in code: particles, stars, panels
// =====================================================================

FUNCTION make_square(sz, r, g, b);
PRIVATE gr;
BEGIN
  gr = new_graphic(sz, sz);
  gfx_fill(gr, r, g, b);
  RETURN gr;
END

// A star from rows of 0/1 digits: filled with (r, g, b), outlined dark,
// its top half a little lighter
FUNCTION make_star(big, r, g, b, lr, lg, lb);
PRIVATE n, gr, xx, yy, nb;
BEGIN
  IF (big) n = 11; ELSE n = 7; END
  // one pixel more than needed: an even size keeps the centre on a pixel
  gr = new_graphic(n + 3, n + 3);
  // outline: every empty pixel next to a filled one
  FOR yy = -1 TO n
    FOR xx = -1 TO n
      IF (NOT star_px(big, n, xx, yy))
        nb = star_px(big, n, xx - 1, yy) OR star_px(big, n, xx + 1, yy) OR star_px(big, n, xx, yy - 1) OR star_px(big, n, xx, yy + 1);
        IF (nb) gfx_pixel(gr, xx + 1, yy + 1, 67, 74, 95); END
      ELSE
        IF (yy < n / 2) gfx_pixel(gr, xx + 1, yy + 1, lr, lg, lb); ELSE gfx_pixel(gr, xx + 1, yy + 1, r, g, b); END
      END
    END
  END
  RETURN gr;
END

FUNCTION star_px(big, n, xx, yy);
PRIVATE row;
BEGIN
  IF (xx < 0 OR yy < 0 OR xx >= n OR yy >= n) RETURN 0; END
  IF (big) row = STAR_BIG[yy]; ELSE row = STAR_SMALL[yy]; END
  RETURN (row / pow(10, n - 1 - xx)) % 10;
END

// A panel: dark outline, light face and a darker bottom lip
FUNCTION make_panel(w, h);
PRIVATE gr;
BEGIN
  gr = new_graphic(w, h);
  gfx_rect(gr, 1, 0, w - 2, h, 67, 74, 95);
  gfx_rect(gr, 0, 1, w, h - 2, 67, 74, 95);
  gfx_rect(gr, 2, 2, w - 4, h - 4, 223, 246, 245);
  gfx_rect(gr, 2, h - 6, w - 4, 4, 194, 227, 232);
  gfx_rect(gr, 2, 2, w - 4, 2, 255, 255, 255);
  RETURN gr;
END

FUNCTION make_graphics();
PRIVATE i;
BEGIN
  FOR i = 0 TO 179
    tg[i] = cut_tile(i);
  END
  FOR i = 0 TO 26
    cg[i] = load_tile(CHARS, (i % 9) * 24, (i / 9) * 24, 24, 24);
  END
  FOR i = 0 TO 23
    bgt[i] = load_tile(BACKS, (i % 8) * 24, (i / 8) * 24, 24, 24);
  END
  g_hud = new_graphic(SW, 18);
  gfx_fill(g_hud, 67, 74, 95);
  gfx_rect(g_hud, 0, 17, SW, 1, 42, 46, 62);
  gfx_rect(g_hud, 0, 0, SW, 1, 110, 118, 146);
  g_screen = new_graphic(SW, SH);
  gfx_fill(g_screen, 29, 32, 48);
  g_px[0] = make_square(2, 255, 255, 255);
  g_px[1] = make_square(2, 254, 228, 129);
  g_px[2] = make_square(4, 244, 180, 27);
  g_px[3] = make_square(2, 54, 227, 119);
  g_px[4] = make_square(4, 46, 176, 130);
  g_px[5] = make_square(2, 221, 68, 44);
  g_px[6] = make_square(4, 203, 129, 94);
  g_px[7] = make_square(2, 76, 229, 253);
  g_px[8] = make_square(4, 223, 246, 245);
  g_px[9] = make_square(2, 159, 90, 82);
  g_star = make_star(1, 244, 180, 27, 254, 228, 129);
  g_star_off = make_star(1, 149, 154, 177, 190, 196, 214);
  g_sstar = make_star(0, 244, 180, 27, 254, 228, 129);
  g_sstar_off = make_star(0, 116, 122, 144, 149, 154, 177);
  g_dot = new_graphic(4, 4);
  gfx_rect(g_dot, 1, 0, 2, 4, 67, 74, 95);
  gfx_rect(g_dot, 0, 1, 4, 2, 67, 74, 95);
  gfx_rect(g_dot, 1, 1, 2, 2, 254, 228, 129);
  g_dot_off = new_graphic(4, 4);
  gfx_rect(g_dot_off, 1, 0, 2, 4, 67, 74, 95);
  gfx_rect(g_dot_off, 0, 1, 4, 2, 67, 74, 95);
  gfx_rect(g_dot_off, 1, 1, 2, 2, 190, 196, 214);
  g_panel = make_panel(252, 128);
  g_cold = new_graphic(SW, SH);
  gfx_fill_rgba(g_cold, 110, 150, 235, 16);
  g_cold_s = new_graphic(144, SH);
  gfx_fill_rgba(g_cold_s, 110, 150, 235, 16);
  g_bar = make_panel(300, 40);
  RETURN 0;
END

