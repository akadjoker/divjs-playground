PROGRAM rusty_leap;

// ---------------------------------------------------------------------
// RUSTY LEAP - a side-scrolling jump-and-stomp platformer.
//
// Rusty the fox runs through three worlds - CLOVER MEADOW, GLOWROOT
// CAVERN and CLOUDTOP HEIGHTS - to reach the Waystone at the end of each.
//
// * Controls with some weight: Rusty speeds up and slows down, runs while
//   X/Shift is held, jumps higher the longer the button is held, can still
//   jump for a few frames after running off a ledge (coyote time), and a
//   jump pressed just before landing is kept (jump buffer).
// * Stomp enemies to bounce off them: the MOSSBUG walks, the ROLLO curls
//   into a ball when stomped (touch the ball to send it rolling through
//   other enemies), the BUZZWING flies and the HOPFROG leaps at you.
// * Bump bricks and gift crates from below. Crates hold glimmers (100 are
//   an extra life) or a power: the SUN BERRY makes Rusty big (a hit makes
//   him small again) and, once big, the ACORN SLING lets him throw
//   bouncing acorns with X. Big Rusty breaks bricks.
// * Lanterns are checkpoints; pits and thorns are dangerous; the timer
//   counts down; reaching the Waystone turns the time left into points.
//
// How it is made
// * Levels are built by small functions (gnd, fill, row, ent...) into the
//   tile map tm[]; the static tiles are painted once into one wide graphic
//   that scroll window 1 shows, and bricks and crates are processes (they
//   can break or change). Scroll window 0 draws two parallax planes: its
//   foreground (hills, rock pillars, clouds) and its background (sky).
//   Game processes set cnumber = c_1 so they are drawn in window 1 only.
// * Collisions with the level are done against tm[] (never against
//   graphics), axis by axis, with the player's box kept in globals so the
//   enemies can test stomps and hits themselves.
// * Every sprite is pixel art stored below as rows of palette digits (two
//   numbers of 8 pixels per row); the title and HUD font is a 5x7 pixel
//   font turned into a BDF font at start-up (load_bdf_font_text). Sounds
//   are sfx_tone recipes; each world has its own tune (song_*).
// ---------------------------------------------------------------------

GLOBAL
  // ---- screen and level geometry
  SW = 400; SH = 240; TS = 16; LH = 15;

  // ---- tiles
  T_AIR = 0; T_GROUND = 1; T_STONE = 2; T_BRICK = 3; T_GIFT = 4; T_GIFTP = 5;
  T_USED = 6; T_PLANK = 7; T_THORN = 8;
  tsolid[8] = 0, 1, 1, 1, 1, 1, 1, 0, 0;
  tm[3599];                  // the level: tile at (tx, ty) is tm[ty * lw + tx]
  bump[3599];                // frames left of a block's bump animation
  lw = 0;                    // level width in tiles
  theme = 0;                 // 0 meadow, 1 cavern, 2 sky
  tb = 0;                    // theme * 48: base of the theme's colours in tc[]

  // ---- level entities (filled by the level functions, spawned by spawn_level)
  E_GEM = 1; E_BUG = 2; E_DIL = 3; E_BEE = 4; E_FROG = 5; E_CHECK = 6; E_GOAL = 7;
  E_START = 8; E_MPH = 9; E_MPV = 10; E_BEEV = 11;
  ne = 0; e_k[119]; e_x[119]; e_y[119]; e_p[119];
  start_tx = 2; start_ty = 12; goal_tx = 0; check_tx = 0;

  // ---- enemies register here so stomps, acorns and rolling balls find them
  NFOE = 40;
  f_on[39]; f_x[39]; f_y[39]; f_hit[39];

  // ---- moving platforms (left x, top y, width, movement this frame)
  nmp = 0; mp_x[7]; mp_y[7]; mp_w[7]; mp_dx[7]; mp_dy[7];

  // ---- the player (feet position pfx, pfy; hitbox half-width phw, height ph)
  pfx = 0.0; pfy = 0.0; pvx = 0.0; pvy = 0.0;
  phw = 5; ph = 14;
  pbig = 0; psling = 0; pinv = 0; pface = 1; pground = 0; pdead = 0;
  pgrow = 0; pchain = 0; pon = -1; pbuf = 0; pcoy = 0; pjump = 0; plook = 0.0;
  nacorn = 0;
  camx = 0.0; icam = 0;

  // ---- game state
  ST_PLAY = 0; ST_CLEAR = 1; ST_DEAD = 2; ST_GOAL = 3;
  game_state = 0; freeze = 0; paused = 0;
  lvl = 1; NLEVELS = 3;
  score = 0; glims = 0; lives = 3; time_left = 300; time_tick = 0;
  cp = 0;                    // checkpoint reached in this level (tile x), 0 none
  bump_x = 0; bump_y = 0; bump_t = 0;
  hurry = 0;
  stat_stomps = 0; stat_gems = 0; stat_bricks = 0; stat_deaths = 0; stat_blocks = 0;
  stat_kicks = 0; stat_powers = 0; stat_clears = 0; stat_checks = 0;

  // ---- graphics
  g_fox[3]; g_big[3]; g_bug[2]; g_dil[2]; g_bee[1]; g_frog[1];
  g_berry = 0; g_acorn = 0; g_gem = 0; g_gem_small = 0; g_shot = 0;
  g_brick[2]; g_gift[8]; g_used[2]; g_debris[2];
  g_lvl[2];                  // painted level graphics, one per level (made once)
  g_far[2]; g_mid[2];        // parallax planes per theme
  g_hud = 0; g_card = 0; g_lamp[1]; g_goal = 0; g_glow = 0; g_spark[3]; g_puff = 0;
  g_mp[2]; g_cursor = 0; g_logo_bg = 0;
  f_small = 0; f_big = 0;    // pixel fonts

  // ---- theme colours: 16 RGB triples per theme
  C_GRASS = 0; C_GRASS_L = 3; C_GRASS_D = 6; C_DIRT = 9; C_DIRT_D = 12; C_DIRT_L = 15;
  C_ST = 18; C_ST_L = 21; C_ST_D = 24; C_BR = 27; C_BR_M = 30; C_BR_L = 33;
  C_PL = 36; C_PL_D = 39; C_SKY1 = 42; C_SKY2 = 45;
  tc[143] =
    // meadow
    86, 186, 64,  150, 226, 92,  38, 118, 44,  156, 98, 56,  112, 66, 38,  190, 132, 80,
    168, 164, 176,  214, 212, 222,  98, 94, 116,  198, 94, 54,  110, 46, 28,  236, 146, 96,
    196, 132, 64,  118, 70, 32,  84, 160, 255,  190, 232, 255,
    // cavern
    70, 190, 170,  150, 240, 220,  30, 110, 110,  72, 56, 100,  44, 32, 68,  102, 84, 138,
    96, 100, 132,  140, 146, 180,  52, 54, 82,  136, 72, 150,  62, 28, 78,  186, 120, 200,
    96, 214, 230,  40, 120, 150,  16, 12, 34,  40, 26, 64,
    // sky
    250, 252, 255,  255, 255, 255,  190, 196, 236,  232, 236, 252,  196, 198, 236,  255, 255, 255,
    236, 214, 150,  255, 244, 196,  176, 146, 86,  98, 150, 222,  48, 84, 150,  150, 196, 250,
    255, 250, 255,  200, 190, 236,  110, 132, 236,  255, 196, 206;

  // ---- sprite art: rows of 16 pixels as two 8-digit numbers, digits are
  // palette entries (0 = transparent)
  A_FOX_STAND = 0;
  A_FOX_RUN1 = 32;
  A_FOX_RUN2 = 64;
  A_FOX_JUMP = 96;
  A_BUG_A = 128;
  A_BUG_B = 160;
  A_BUG_FLAT = 192;
  A_DIL_A = 224;
  A_DIL_B = 256;
  A_DIL_BALL = 288;
  A_BEE_A = 320;
  A_BEE_B = 352;
  A_FROG_SIT = 384;
  A_FROG_LEAP = 416;
  A_BERRY = 448;
  A_ACORN = 480;
  A_GEM = 512;
  A_BIG_STAND = 544;
  A_BIG_RUN1 = 592;
  A_BIG_RUN2 = 640;
  A_BIG_JUMP = 688;
