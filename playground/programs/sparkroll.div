    "E2 E2 E3 E2 E2 E2 E3 E2 E2 E2 E3 E2 D2 D2 D3 D2 | E2 E2 E3 E2 E2 E2 E3 E2 E2 E2 E3 E2 D2 D2 D3 D2 |" +
    "E2 E2 E3 E2 E2 E2 E3 E2 E2 E2 E3 E2 D2 D2 D3 D2 | C2 C2 C3 C2 C2 C2 C3 C2 B1 B1 B2 B1 B1 B1 B2 B1", 45);
  song_track(mus_boss, inst_drums, "k h s h k h s h k h s h k k s s", 42);

  // title
  mus_title = song_new(140);
  song_track(mus_title, inst_square,
    "G5 . B5 . D6 - B5 . C6 . A5 . F#5 - D5 . | G5 . B5 . D6 - G6 - F#6 . E6 . D6 - - - |" +
    "E6 . D6 . C6 - B5 . A5 . B5 . C6 - A5 . | B5 - G5 - D5 - G5 - G5 - - - . . . .", 28);
  song_track(mus_title, inst_bass,
    "G2 . D3 . G2 . D3 . D2 . A2 . D2 . A2 . | G2 . D3 . G2 . D3 . E2 . B2 . E2 . B2 . |" +
    "C3 . G3 . C3 . G3 . D3 . A3 . D3 . A3 . | G2 . D3 . G2 . D3 . G2 - - - . . . .", 45);
  song_track(mus_title, inst_drums, "k . h . s . h . k . h . s . h .", 36);

  // jingles
  mus_clear = song_new(132);
  song_track(mus_clear, inst_square, "C5 E5 G5 C6 . G5 C6 - E6 - - - D6 - - - C6 - - - - - - - . . . . . . . .", 34);
  song_track(mus_clear, inst_bass, "C3 - - - G2 - - - C3 - - - G2 - - - C3 - - - - - - - . . . . . . . .", 45);
  mus_over = song_new(96);
  song_track(mus_over, inst_square, "E5 - D5 - C5 - B4 - A4 - - - - - - - . . . .", 30);
  song_track(mus_over, inst_bass, "A2 - - - G2 - - - F2 - - - E2 - - - . . . .", 45);
  mus_win = song_new(140);
  song_track(mus_win, inst_square,
    "C5 E5 G5 C6 - G5 C6 E6 - - - . | F5 A5 C6 F6 - C6 F6 A6 - - - . | G5 B5 D6 G6 - - - - - - - . | C6 - - - - - - - . . . .", 30);
  song_track(mus_win, inst_bass,
    "C3 - - - C3 - - - C3 - - - | F2 - - - F2 - - - F2 - - - | G2 - - - G2 - - - G2 - - - | C3 - - - - - - - . . . .", 45);
  song_track(mus_win, inst_drums, "k . s . k . s . k k s . | k . s . k . s . k k s . | k . s . k . s . k k s s | k . . . . . . . . . . .", 36);
  RETURN 0;
END

// =====================================================================
// Setting up
// =====================================================================

FUNCTION init_colours();
BEGIN
  set_zc(0, 0, 70, 200, 110);  set_zc(0, 1, 30, 140, 80);   set_zc(0, 2, 236, 200, 140);
  set_zc(0, 3, 226, 120, 104); set_zc(0, 4, 244, 214, 160); set_zc(0, 5, 206, 100, 96);
  set_zc(0, 6, 232, 132, 110); set_zc(0, 7, 80, 210, 120);  set_zc(0, 8, 170, 80, 70);
  set_zc(0, 9, 150, 84, 80);
  set_zc(1, 0, 250, 200, 40);  set_zc(1, 1, 40, 38, 46);    set_zc(1, 2, 130, 140, 160);
  set_zc(1, 3, 200, 210, 225); set_zc(1, 4, 80, 86, 104);   set_zc(1, 5, 96, 102, 124);
  set_zc(1, 6, 110, 120, 140); set_zc(1, 7, 250, 200, 40);  set_zc(1, 8, 60, 64, 80);
  set_zc(1, 9, 58, 60, 76);
  RETURN 0;
END

// Kip's frames: 0 stand, 1-4 run, 5-8 fast, 9 crouch, 10 hurt,
// 11 spring, 12 dead, 13 skid
FUNCTION make_kip_frames();
PRIVATE i;
BEGIN
  g_kip[0] = make_kip(0, 0);
  FOR i = 0 TO 3
    g_kip[1 + i] = make_kip(1, i);
    g_kip[5 + i] = make_kip(2, i);
  END
  RETURN 0;
END

FUNCTION make_kip_frames2();
BEGIN
  g_kip[9] = make_kip(3, 0);
  g_kip[10] = make_kip(4, 0);
  g_kip[11] = make_kip(5, 0);
  g_kip[12] = make_kip(6, 0);
  g_kip[13] = make_kip(7, 0);
  g_ball[0] = make_ball(0);
  g_ball[1] = make_ball(1);
  RETURN 0;
END

FUNCTION make_objects();
PRIVATE i;
BEGIN
  FOR i = 0 TO 3
    g_spark[i] = make_spark(i);
    g_boom[i] = make_boom(i);
    g_spring[i] = make_spring(i);
    g_boss[i] = make_boss(i);
  END
  RETURN 0;
END

FUNCTION make_objects2();
PRIVATE i;
BEGIN
  FOR i = 0 TO 1
    g_walker[i] = make_walker(0, i);
    g_walker[2 + i] = make_walker(1, i);
    g_flyer[i] = make_flyer(0, i);
    g_flyer[2 + i] = make_flyer(1, i);
    g_boost[i] = make_boost(i);
    g_check[i] = make_check(i);
    g_goal[i] = make_goal(i);
  END
  g_crate = make_crate();
  g_bomb = make_bomb();
  g_dust = new_graphic(14, 14);
  gfx_fill_rgba(g_dust, 0, 0, 0, 0);
  gfx_circle(g_dust, 7, 7, 6, 230, 225, 215);
  gfx_circle(g_dust, 5, 6, 3, 255, 255, 250);
  g_hud = new_graphic(SW, SH);
  set_point(0, g_hud, 0, 0, 0);
  g_res = new_graphic(300, 150);
  RETURN 0;
END

// =====================================================================
// Game flow
// =====================================================================

// Everything Kip carries back to a fresh start
FUNCTION reset_kip();
BEGIN
  hx = cp_x; hy = cp_y; xsp = 0; ysp = 0; gsp = 0; ga = 0;
  onground = 1; ball = 0; rolling = 0; hmode = 0; facing = 1;
  hr = 19; wr = 9; ctrl_lock = 0; invuln = 0; hurt = 0; dead = 0;
  crouch = 0; charging = 0; rev = 0; jumped = 0; sprung = 0;
  spr_ang = 0; layer = 0; goal_hit = 0; loop_last = -1;
  sparks = 0; hud_dirty = 1;
  arena_on = 0; boss_hp = 0;
  cam_x = clamp(hx - SW * 0.4, 0, lv_w - SW);
  cam_y = clamp(hy - SH * 0.56, lv_top, lv_bottom - SH);
  cam_lead = 0;
  scroll.x0 = int(cam_x);
  scroll.y0 = int(cam_y);
  RETURN 0;
END

// Builds (fresh) or restarts (after a fall) zone z, with fades
PROCESS loader(zn, fresh);
PRIVATE i;
BEGIN
  gstate = ST_LOAD;
  fade_off(10);
  WHILE (is_fading()) FRAME; END
  gen++;
  FRAME;
  zone = zn;
  IF (fresh)
    level_reset();
    FRAME;
    IF (zone == 0) coast_a(); ELSE works_a(); END
    FRAME;
    IF (zone == 0) coast_b(); ELSE works_b(); END
    FRAME;
    level_finish();
    cp_x = start_x; cp_y = start_y; cp_time = 0;
    boss_beaten = 0;
  ELSE
    FOR i = 0 TO nobj - 1
      ob_s[i] = 0;
    END
  END
  FOR i = 0 TO 127 ch_alive[i] = 0; END
  frames = cp_time;
  reset_kip();
  start_scroll(0, 0, 0, g_sky[zone], 0, 0);
  scroll.x0 = int(cam_x); scroll.y0 = int(cam_y);
  keep_chunks(1);
  FRAME; FRAME; FRAME; FRAME;
  bglayer(0, 0); bglayer(0, 1); bglayer(1, 0); bglayer(1, 1);
  hud();
  kip_id = kip();
  card();
  spawn_objects();
  frozen = 1;
  gstate = ST_CARD; st_t = 0;
  IF (zone == 0) music(mus_coast); ELSE music(mus_works); END
  fade_on(10);
END

FUNCTION go_title();
BEGIN
  gen++;
  gstate = ST_TITLE; st_t = 0;
  zone = 0;
  cam_x = 0; cam_y = 470; start_y = 640 - 19;
  start_scroll(0, 0, 0, g_sky[0], 0, 0);
  bglayer(0, 0); bglayer(0, 1); bglayer(1, 0); bglayer(1, 1);
  title_logo();
  title_kip();
  music(mus_title);
  RETURN 0;
END

PRIVATE i, k, sec;
BEGIN
  set_mode(480, 270);
  set_fps(60, 0);
  screen_color('#000000');
  init_colours();
  make_kip_frames();
  FRAME;
  make_kip_frames2();
  FRAME;
  make_objects();
  FRAME;
  make_objects2();
  FRAME;
  FOR i = 0 TO 1
    g_sky[i] = make_sky(i);
    FRAME;
    g_far[i] = make_far(i);
    set_point(0, g_far[i], 0, 0, 0);
    FRAME;
    g_mid[i] = make_mid(i);
    set_point(0, g_mid[i], 0, 0, 0);
    FRAME;
    g_zcard[i] = make_zcard(i);
  END
  g_title = make_title();
  make_sounds();
  go_title();

  LOOP
    st_t++;
    fps_now = get_fps();

    IF (gstate == ST_TITLE)
      cam_x += 2;
      IF (key_pressed(_enter) OR key_pressed(_space))
        play_sound(s_start, 70, 100, 0);
        score = 0; lives = 3; next_life = 100;
        loader(0, 1);
      END
    END

    IF (gstate == ST_CARD)
      spawn_objects();
      keep_chunks(0);
      IF (st_t > 60) frozen = 0; END
      IF (st_t > 90) gstate = ST_PLAY; st_t = 0; END
    END

    IF (gstate == ST_PLAY)
      frames++;
      IF (st_t > 120 AND fps_now > 0 AND fps_now < fps_min) fps_min = fps_now; END
      spawn_objects();
      keep_chunks(0);
      // the boss arena closes behind Kip
      IF (zone == 1 AND NOT boss_beaten AND NOT arena_on AND hx > arena_x + 180 AND hx < arena_x + SW)
        arena_on = 1;
        lock_x1 = arena_x; lock_x2 = arena_x + SW;
        boss_id = boss();
        music(mus_boss);
      END
    END

    IF (gstate == ST_CLEAR)
      spawn_objects();
      keep_chunks(0);
      IF (st_t == 60)
        music(mus_clear);
        sec = frames / 60;
        bonus_time = 1000;
        IF (sec < 180) bonus_time = 3000; END
        IF (sec < 120) bonus_time = 5000; END
        IF (sec < 90) bonus_time = 8000; END
        IF (sec < 60) bonus_time = 12000; END
        IF (sec < 40) bonus_time = 20000; END
        bonus_spark = sparks * 100;
        results();
      END
      IF (st_t > 150)
        k = 0;
        IF (bonus_time > 0) k = min(bonus_time, 200); bonus_time -= k; score += k; END
        IF (bonus_spark > 0) i = min(bonus_spark, 200); bonus_spark -= i; score += i; k += i; END
        hud_dirty = 1;
        IF (k > 0 AND st_t % 4 == 0) play_sound(s_tally, 40, 100, 0); END
        IF (k == 0 AND st_t < 9999) st_t = 9999; play_sound(s_life, 60, 100, 0); END
      END
      IF (st_t > 10140)
        IF (zone == 0)
          loader(1, 1);
        ELSE
          gstate = ST_WIN; st_t = 0;
          signal(TYPE results, s_kill);
          make_end(1);
          endscreen();
          music(mus_win);
        END
      END
    END

    IF (gstate == ST_DEAD AND st_t > 140)
      lives--;
      hud_dirty = 1;
      IF (lives > 0)
        loader(zone, 0);
      ELSE
        gstate = ST_OVER; st_t = 0;
        make_end(0);
        endscreen();
        music(mus_over);
      END
    END

    IF ((gstate == ST_OVER OR gstate == ST_WIN) AND st_t > 60)
      IF (key_pressed(_enter) OR key_pressed(_space))
        mus_now = 0;
        go_title();
      END
    END

    // floating score
    IF (pop_t > 0)
      pop_t--;
      set_color('#ffffff');
      text(pop_x - cam_x - 12, pop_y - cam_y - (50 - pop_t) * 0.5, pop_s);
    END
    FRAME;
  END
END
