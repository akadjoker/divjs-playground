{
  "name": "divjs-playground",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "The DivJS playground, games and demos",
  "scripts": {
    "engine": "node tools/engine.mjs",
    "test:pipeline": "node tests/test.mjs",
    "test:browser": "node tests/browser.mjs",
    "lint": "eslint .",
    "build:vendor": "esbuild playground/vendor-src/codemirror.js --bundle --format=esm --minify --legal-comments=eof --banner:js=\"/* CodeMirror 6 (MIT, https://codemirror.net) bundled by esbuild - generated by npm run build:vendor, do not edit. Licences: see THIRD_PARTY_NOTICES.md */\" --outfile=playground/vendor/codemirror.js",
    "build:blockly": "node tools/build-blockly.mjs",
    "capture": "node tools/capture.mjs",
    "trailer": "node tools/trailer/index.mjs"
  },
  "dependencies": {
    "divjs": "github:akadjoker/divjs#91b82f9f4d87bd28394ff2a8e8d581c8ee7572b6"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "blockly": "^13.3.0",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "fflate": "^0.8.3",
    "ffmpeg-static": "^5.3.0",
    "gifenc": "^1.0.3",
    "playwright": "~1.56.1"
  }
}
